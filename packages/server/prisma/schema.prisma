// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  player
  admin
}

model Account {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  role         Role        @default(player)
  characters   Character[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// A character is the in-game identity (name, position, class) an account
// plays as. One account can own several — the account is just the login.
model Character {
  id             String         @id @default(cuid())
  accountId      String
  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String         @unique
  x              Float
  y              Float
  classId        String?
  class          ClassTemplate? @relation(fields: [classId], references: [id])
  level          Int            @default(1)
  experience     Int            @default(0)
  armor          Float          @default(0)
  strength       Float          @default(0)
  intelligence   Float          @default(0)
  dexterity      Float          @default(0)
  criticalChance Float          @default(5)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ClassTemplate {
  id         String          @id @default(cuid())
  name       String          @unique
  color      Int
  spells     SpellTemplate[]
  characters Character[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model MonsterTemplate {
  id                 String   @id @default(cuid())
  name               String
  maxHp              Float
  wanderRadius       Float
  wanderIntervalMs   Int
  wanderSpeed        Float
  aggroRange         Float
  chaseSpeed         Float
  attackRange        Float
  touchDamage        Float
  attackCooldownMs   Int
  level              Int      @default(1)
  armor              Float    @default(0)
  xpReward           Int      @default(20)
  spawns             MonsterSpawn[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SpellTemplate {
  id              String        @id @default(cuid())
  classId         String
  class           ClassTemplate @relation(fields: [classId], references: [id], onDelete: Cascade)
  keybind         Int
  name            String
  kind            String
  cooldownMs      Int
  castTimeMs      Int           @default(0)
  color           Int
  size            Float
  damage          Float?
  projectileSpeed Float?
  maxRange        Float?
  aoeRadius       Float?
  slowMultiplier  Float?
  slowDurationMs  Int?
  healAmount      Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([classId, keybind])
}

model GameMap {
  id        String   @id @default(cuid())
  name      String
  width     Int
  height    Int
  tileSize  Int      @default(32)
  tileData  String
  spawnX    Float
  spawnY    Float
  isActive  Boolean  @default(false)
  spawns    MonsterSpawn[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MonsterSpawn {
  id                String          @id @default(cuid())
  mapId             String
  map               GameMap         @relation(fields: [mapId], references: [id], onDelete: Cascade)
  monsterTemplateId String
  monsterTemplate   MonsterTemplate @relation(fields: [monsterTemplateId], references: [id], onDelete: Cascade)
  x                 Float
  y                 Float
}
