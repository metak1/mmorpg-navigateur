// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  player
  admin
}

model Account {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  role         Role        @default(player)
  characters   Character[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// A character is the in-game identity (name, position, class) an account
// plays as. One account can own several — the account is just the login.
model Character {
  id             String           @id @default(cuid())
  accountId      String
  account        Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String           @unique
  x              Float
  y              Float
  classId        String?
  class          ClassTemplate?   @relation(fields: [classId], references: [id])
  level          Int              @default(1)
  experience     Int              @default(0)
  armor          Float            @default(0)
  strength       Float            @default(0)
  intelligence   Float            @default(0)
  dexterity      Float            @default(0)
  criticalChance Float            @default(5)
  items          CharacterItem[]
  quests         CharacterQuest[]
  equipment      CharacterEquipment[]
  talents        CharacterTalent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ClassTemplate {
  id         String           @id @default(cuid())
  name       String           @unique
  color      Int
  spells     SpellTemplate[]
  talents    TalentTemplate[]
  characters Character[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model MonsterTemplate {
  id                 String   @id @default(cuid())
  name               String
  maxHp              Float
  wanderRadius       Float
  wanderIntervalMs   Int
  wanderSpeed        Float
  aggroRange         Float
  chaseSpeed         Float
  attackRange        Float
  touchDamage        Float
  attackCooldownMs   Int
  level              Int      @default(1)
  armor              Float    @default(0)
  xpReward           Int      @default(20)
  // Optional ranged spell attack, on top of the always-present melee touch
  // attack above — null (the default, on every existing monster) means
  // melee-only, zero behavior change. All five are set together or not at
  // all (see WorldRoom.updateMonsters).
  spellDamage        Float?
  spellRange         Float?
  spellCastTimeMs    Int?
  spellCooldownMs    Int?
  spellColor         Int?
  spawns             MonsterSpawn[]
  quests             Quest[]
  drops              MonsterDrop[]
  ambientSpawnOf     MapAmbientSpawn[]
  dungeonObjectives  DungeonObjective[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// One entry in a monster's loot table. dropChance is a percent (0-100)
// rolled independently per entry on kill, so a monster can drop several
// entries (or none) from a single death rather than picking exactly one.
model MonsterDrop {
  id                String          @id @default(cuid())
  monsterTemplateId String
  monsterTemplate   MonsterTemplate @relation(fields: [monsterTemplateId], references: [id], onDelete: Cascade)
  itemId            String
  item              ItemTemplate    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  dropChance        Float           @default(10)
  minQuantity       Int             @default(1)
  maxQuantity       Int             @default(1)

  @@unique([monsterTemplateId, itemId])
}

model SpellTemplate {
  id              String        @id @default(cuid())
  classId         String
  class           ClassTemplate @relation(fields: [classId], references: [id], onDelete: Cascade)
  keybind         Int
  name            String
  kind            String
  cooldownMs      Int
  castTimeMs      Int           @default(0)
  color           Int
  size            Float
  damage          Float?
  projectileSpeed Float?
  maxRange        Float?
  aoeRadius       Float?
  slowMultiplier  Float?
  slowDurationMs  Int?
  healAmount      Float?
  talentEffects   TalentEffect[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([classId, keybind])
}

// A talent tree node belonging to one class. tier is a display/authoring
// grouping (row in the tree); prerequisite optionally requires another
// talent in the same tree to have >=1 point spent before this one is
// learnable (see shared/src/talents.ts's canLearnTalent, the single rule
// both server and client evaluate). maxRank lets a talent be bought
// multiple times, scaling its effects linearly per rank (see TalentEffect).
model TalentTemplate {
  id             String           @id @default(cuid())
  classId        String
  class          ClassTemplate    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name           String
  description    String
  tier           Int              @default(1)
  maxRank        Int              @default(1)
  prerequisiteId String?
  // SetNull (not Cascade) so deleting a prerequisite talent doesn't cascade
  // into deleting every talent that required it — it just becomes
  // unconditionally learnable instead.
  prerequisite   TalentTemplate?  @relation("TalentPrerequisite", fields: [prerequisiteId], references: [id], onDelete: SetNull)
  dependents     TalentTemplate[] @relation("TalentPrerequisite")
  effects        TalentEffect[]
  characterTalents CharacterTalent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

enum TalentEffectType {
  statBonus
  spellModifier
  mechanicFlag
}

enum TalentBonusMode {
  flat
  percent
}

// One effect a talent applies per rank spent on it. Which fields are
// meaningful depends on effectType: statBonus uses statKey; spellModifier
// uses spellTemplateId+spellParam; both use bonusMode+valuePerRank.
// mechanicFlag only uses flagName — it's plumbing for a fixed, growing set
// of named bespoke gameplay hooks (see shared/src/api-types.ts's
// TALENT_MECHANIC_FLAGS) with no numeric effect of its own; the actual
// gameplay behavior behind each flag name is implemented in server code
// separately, one at a time, as requested.
model TalentEffect {
  id               String            @id @default(cuid())
  talentTemplateId String
  talentTemplate   TalentTemplate    @relation(fields: [talentTemplateId], references: [id], onDelete: Cascade)
  effectType       TalentEffectType
  statKey          String?
  spellTemplateId  String?
  spellTemplate    SpellTemplate?    @relation(fields: [spellTemplateId], references: [id], onDelete: Cascade)
  spellParam       String?
  bonusMode        TalentBonusMode?
  valuePerRank     Float?
  flagName         String?
}

model GameMap {
  id                 String   @id @default(cuid())
  name               String
  tileSize           Int      @default(32)
  spawnX             Float
  spawnY             Float
  isActive           Boolean  @default(false)
  // Probability (0-1), rolled once per newly-entered chunk per player, that
  // one ambient monster spawns somewhere walkable in that chunk — see
  // MapAmbientSpawn for which monsters are eligible.
  ambientSpawnChance Float    @default(0.3)
  // Solid fill color (0xrrggbb) for the "riser" face drawn between two
  // adjacent tiles with different elevation — e.g. brown for a dirt cliff,
  // gray for stone. Purely cosmetic, rendered client-side only. Default is
  // a dirt brown (0x6b4a2f).
  cliffColor         Int      @default(7031343)
  // A dungeon map is never the (single) active overworld map — it's only
  // ever entered through a portal, as its own instanced WorldRoom (see
  // WorldRoom's mapId/allowedCharacterIds room options). minLevel gates
  // entry (checked against every member of the entering party) and is only
  // meaningful when isDungeon is true.
  isDungeon          Boolean  @default(false)
  minLevel           Int      @default(1)
  // Shown to players in the dungeon-entry prompt (see WorldRoom's
  // "dungeonPrompt" message) before they commit to entering — only
  // meaningful when isDungeon is true, same as minLevel.
  description        String   @default("")
  spawns             MonsterSpawn[]
  npcSpawns          NpcSpawn[]
  tiles              MapTile[]
  ambientSpawns      MapAmbientSpawn[]
  portals            MapPortal[] @relation("PortalSource")
  portalTargetOf     MapPortal[] @relation("PortalTarget")
  dungeonObjectives  DungeonObjective[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum DungeonObjectiveKind {
  killBoss
  killAllMonsters
  killCount
}

// One entry in an ordered checklist of goals a dungeon instance tracks live
// (see WorldRoom's synced dungeonObjectives room state) — completing every
// objective clears the dungeon (broadcasts dungeonCleared, spawns the exit
// portal), replacing the old hardcoded "any boss kill clears it" rule for
// any map that defines at least one (see WorldRoom.updateDungeonObjectives;
// a map with none keeps the old boss-only behavior unchanged). Only
// meaningful when the owning map's isDungeon is true.
model DungeonObjective {
  id                String               @id @default(cuid())
  mapId             String
  map               GameMap              @relation(fields: [mapId], references: [id], onDelete: Cascade)
  // Display/checklist order — purely presentational, doesn't affect
  // completion (every objective must complete regardless of order).
  order             Int                  @default(0)
  description       String
  kind              DungeonObjectiveKind
  // killCount only — which monster template counts toward it.
  monsterTemplateId String?
  monsterTemplate   MonsterTemplate?     @relation(fields: [monsterTemplateId], references: [id])
  // killCount only (admin-set, must be >=1). killBoss is always 1 and
  // killAllMonsters is always the dungeon's total hand-placed monster
  // count — both computed at room creation instead, not stored here (see
  // WorldRoom.onCreate).
  requiredCount     Int?
}

// A portal placed on one map that leads to another. A dungeon's own return
// portal is just another row, placed on the dungeon map, targeting the
// overworld map — there's no separate "exit" concept.
model MapPortal {
  id          String  @id @default(cuid())
  mapId       String
  map         GameMap @relation("PortalSource", fields: [mapId], references: [id], onDelete: Cascade)
  x           Float
  y           Float
  targetMapId String
  targetMap   GameMap @relation("PortalTarget", fields: [targetMapId], references: [id])
}

// Sparse hand-painted terrain: only tiles an admin explicitly painted get a
// row here. Any (col,row) with no row is a "default" walkable Grass tile —
// this (not width/height) is what makes the map infinite: there is no edge,
// just an ever-larger sparse set of overrides on top of a Grass default.
model MapTile {
  id        String  @id @default(cuid())
  mapId     String
  map       GameMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  col       Int
  row       Int
  tileType  Int
  // Height level, relative to the default (0). Movement between adjacent
  // tiles whose elevation differs by more than MAX_ELEVATION_STEP is
  // blocked (see shared/src/map.ts) and higher tiles render visually
  // raised in the isometric client.
  elevation Int     @default(0)

  @@unique([mapId, col, row])
}

// Which monster templates can spawn procedurally as players wander into
// unauthored chunks, and their relative pick weight.
model MapAmbientSpawn {
  id                String          @id @default(cuid())
  mapId             String
  map               GameMap         @relation(fields: [mapId], references: [id], onDelete: Cascade)
  monsterTemplateId String
  monsterTemplate   MonsterTemplate @relation(fields: [monsterTemplateId], references: [id], onDelete: Cascade)
  weight            Float           @default(1)
}

model MonsterSpawn {
  id                String          @id @default(cuid())
  mapId             String
  map               GameMap         @relation(fields: [mapId], references: [id], onDelete: Cascade)
  monsterTemplateId String
  monsterTemplate   MonsterTemplate @relation(fields: [monsterTemplateId], references: [id], onDelete: Cascade)
  x                 Float
  y                 Float
  // Marks this specific placement (not the template) as a dungeon's boss —
  // the same monster template could otherwise be placed multiple times, so
  // "boss" has to live on the placement, not the template. Meaningful only
  // on a dungeon map; killing it broadcasts DungeonClearedMessage instead of
  // (or alongside) the normal per-killer loot.
  isBoss            Boolean         @default(false)
}

// An NPC's "kind" (name/color) plus every quest it's involved in. Quests
// reference the template, not a specific spawn, so the same NPC "type" can
// appear on multiple maps and still give/require the same quests.
model NpcTemplate {
  id                String     @id @default(cuid())
  name              String
  color             Int
  spawns            NpcSpawn[]
  questsGiven       Quest[]    @relation("QuestGiver")
  questTalkTargets  Quest[]    @relation("QuestTalkTarget")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model NpcSpawn {
  id            String      @id @default(cuid())
  mapId         String
  map           GameMap     @relation(fields: [mapId], references: [id], onDelete: Cascade)
  npcTemplateId String
  npcTemplate   NpcTemplate @relation(fields: [npcTemplateId], references: [id], onDelete: Cascade)
  x             Float
  y             Float
}

// The category an equippable item belongs to. Ring/trinket are categories,
// not concrete slots — a character has two of each (see EquipmentSlot) and
// either can hold an item of that category.
enum ItemSlotType {
  helmet
  gloves
  chest
  spalders
  boots
  legs
  amulet
  ring
  trinket
}

enum ItemRarity {
  common
  rare
  epic
  legendary
}

// The concrete, addressable slots on a character. ring1/ring2 both accept
// ItemSlotType.ring items; trinket1/trinket2 both accept ItemSlotType.trinket.
enum EquipmentSlot {
  helmet
  gloves
  chest
  spalders
  boots
  legs
  amulet
  ring1
  ring2
  trinket1
  trinket2
}

model ItemTemplate {
  id                  String               @id @default(cuid())
  name                String
  description         String
  color               Int
  // null = not equippable (quest/misc items like "Widget").
  slotType            ItemSlotType?
  rarity              ItemRarity           @default(common)
  bonusArmor          Float                @default(0)
  bonusStrength       Float                @default(0)
  bonusIntelligence   Float                @default(0)
  bonusDexterity      Float                @default(0)
  bonusCriticalChance Float                @default(0)
  bonusHp             Float                @default(0)
  rewardOf            QuestRewardItem[]
  bringQuests         Quest[]              @relation("QuestBringItem")
  inventoryOf         CharacterItem[]
  equippedBy          CharacterEquipment[]
  dropSources         MonsterDrop[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model CharacterItem {
  id          String       @id @default(cuid())
  characterId String
  character   Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId      String
  item        ItemTemplate @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity    Int          @default(1)

  @@unique([characterId, itemId])
}

model CharacterEquipment {
  id          String        @id @default(cuid())
  characterId String
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  slot        EquipmentSlot
  itemId      String
  item        ItemTemplate  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([characterId, slot])
}

// Points a character has spent on a talent, and at what rank. Unlike
// CharacterItem/CharacterEquipment (which persist eagerly but only reflect
// what's currently owned/worn), this is a one-way ratchet — rank only ever
// increases, there's no "unlearn" flow, matching the (recommended) minimal
// scope of the in-game talent panel.
model CharacterTalent {
  id          String         @id @default(cuid())
  characterId String
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  talentId    String
  talent      TalentTemplate @relation(fields: [talentId], references: [id], onDelete: Cascade)
  rank        Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([characterId, talentId])
}

enum QuestObjectiveType {
  talkToNpc
  killMonsters
  bringItems
}

// One objective per quest, following the same flat-table-with-nullable-
// kind-specific-columns shape as SpellTemplate (kind + damage/healAmount/
// aoeRadius etc) rather than a separate objective table — simpler to author
// and query for a single-objective quest.
model Quest {
  id                String             @id @default(cuid())
  title             String
  description       String
  giverNpcId        String
  giverNpc          NpcTemplate        @relation("QuestGiver", fields: [giverNpcId], references: [id], onDelete: Cascade)
  objectiveType     QuestObjectiveType
  // talkToNpc
  targetNpcId       String?
  targetNpc         NpcTemplate?       @relation("QuestTalkTarget", fields: [targetNpcId], references: [id])
  // killMonsters
  monsterTemplateId String?
  monsterTemplate   MonsterTemplate?   @relation(fields: [monsterTemplateId], references: [id])
  // bringItems
  itemId            String?
  item              ItemTemplate?      @relation("QuestBringItem", fields: [itemId], references: [id])
  // killMonsters / bringItems count target; unused (always 1, satisfied by
  // the talk itself) for talkToNpc.
  requiredCount     Int                @default(1)
  rewardXp          Int                @default(0)
  rewardItems       QuestRewardItem[]
  characterQuests   CharacterQuest[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model QuestRewardItem {
  id       String       @id @default(cuid())
  questId  String
  quest    Quest        @relation(fields: [questId], references: [id], onDelete: Cascade)
  itemId   String
  item     ItemTemplate @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity Int          @default(1)
}

enum QuestStatus {
  active
  completed
}

model CharacterQuest {
  id          String      @id @default(cuid())
  characterId String
  character   Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest       @relation(fields: [questId], references: [id], onDelete: Cascade)
  status      QuestStatus @default(active)
  // Current count toward requiredCount for killMonsters; unused (informational
  // only) for talkToNpc/bringItems, which are checked directly at turn-in.
  progress    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([characterId, questId])
}
